#: contents/config/config.qml:6 contents/ui/OutputList.qml:50
msgid "Output devices"
msgstr "Dispositivos de salida"

#: contents/config/config.qml:12
msgid "General"
msgstr "General"

#: contents/ui/configDevices.qml:112
msgid ""
"Drag to set the order, untick a device to skip it and pick an icon to "
"replace the one the system gives it."
msgstr ""
"Arrastra para definir el orden, desmarca un dispositivo para omitirlo y "
"elige un icono para reemplazar el que le da el sistema."

#: contents/ui/configDevices.qml:128
msgid "No output devices found"
msgstr "No se encontraron dispositivos de salida"

#: contents/ui/configDevices.qml:129 contents/ui/main.qml:31
msgid "Connect speakers or headphones and they will show up here"
msgstr "Conecta parlantes o audífonos y aparecerán aquí"

#: contents/ui/configDevices.qml:172
msgid "Include %1 in the rotation"
msgstr "Incluir %1 en la rotación"

#: contents/ui/configDevices.qml:184
msgid "Choose icon for %1"
msgstr "Elegir icono para %1"

#: contents/ui/configDevices.qml:209
msgid "Reset icon of %1"
msgstr "Restablecer el icono de %1"

#: contents/ui/configGeneral.qml:16
msgid "Switch output"
msgstr "Cambiar salida"

#: contents/ui/configGeneral.qml:16
